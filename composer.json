{
  "name": "wexample/symfony-accounting-demo",
  "version": "1.0.1",
  "type": "library",
  "license": "MIT",
  "description": "A demo of symfony-accounting-ds: a French and a Belgian ledger, their documents, a bank statement and a fiscal year",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyAccountingDemo\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyAccountingDemo\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/symfony-helpers": ">=15.0.0",
    "wexample/symfony-loader": ">=22.0.0",
    "wexample/symfony-design-system": ">=32.0.0",
    "wexample/symfony-accounting": ">=5.0.2",
    "wexample/symfony-accounting-fr": ">=3.0.0",
    "wexample/symfony-accounting-be": ">=3.0.0",
    "wexample/symfony-accounting-ds": ">=1.0.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^13"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}
