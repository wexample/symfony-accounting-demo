{
  "name": "wexample/symfony-accounting-demo",
  "version": "3.0.5",
  "type": "library",
  "license": "MIT",
  "description": "A demo of symfony-accounting-ds: a French and a Belgian ledger, their documents, a bank statement and a fiscal year",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyAccountingDemo\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyAccountingDemo\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/symfony-helpers": ">=18.0.2",
    "wexample/symfony-loader": ">=25.0.1",
    "wexample/symfony-design-system": ">=39.0.3",
    "wexample/symfony-accounting": ">=8.0.3",
    "wexample/symfony-accounting-fr": ">=5.0.2",
    "wexample/symfony-accounting-be": ">=6.0.2",
    "wexample/symfony-accounting-ds": ">=2.1.5",
    "wexample/symfony-organization": ">=3.0.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^13"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}